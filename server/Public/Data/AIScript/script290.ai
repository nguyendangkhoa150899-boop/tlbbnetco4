;圣兽山狂暴龙：
;1.攻击中20%机率释放 高击猛击（633）
;2.攻击中20%机率释放 高击连击（634）
;3.血少于50%时 群体恐惧（603）3次
;4.血少于20% 狂暴（628）
;每隔1分钟，释放群体定身技能（新技能，群体定身751）
;每隔3分钟，释放群体百分比伤血技能（新技能，天罚，瞬发，减少玩家25%的血，范围16米,750）
;每隔3分钟，释放强力诅咒技能（新技能，修罗咒,748）。
;8.施放烈爪狂击(588),好了就放
[common]
[commonend]

[skill]
0:if(AIS_GetAIState()=SATTACK&AIS_IsCanSkill(0)=1){AIS_ToSkill(0);AIS_SetTimes(-1);AIS_SetPRI(30);};如果能使用0号技能（普通攻击）则释放，次数不限
1:if(AIS_GetAIState()=SATTACK&AIS_GetHP()<30&AIS_IsCanSkill(603)=1){AIS_ToSkill(603);AIS_SetTimes(3);AIS_SetPRI(33);};血少于50%时释放603号技能（群体恐惧），次数3次
2:if(AIS_GetAIState()=SATTACK&AIS_GetHP()<20&AIS_IsCanSkill(628)=1){AIS_ToSkill(628);AIS_SetTimes(1);AIS_SetPRI(34);};血少于20%时释放628号技能（加攻击加会心），次数1次
3:if(AIS_GetAIState()=SATTACK&AIS_Rand()<100&AIS_IsCanSkill(751)=1){AIS_ToSkill(751);AIS_SetTimes(-1);AIS_SetPRI(35);};
4:if(AIS_GetAIState()=SATTACK&AIS_Rand()<100&AIS_IsCanSkill(750)=1){AIS_ToSkill(750);AIS_SetTimes(-1);AIS_SetPRI(36);};
5:if(AIS_GetAIState()=SATTACK&AIS_Rand()<100&AIS_IsCanSkill(748)=1){AIS_ToSkill(748);AIS_SetTimes(-1);AIS_SetPRI(37);};
6:if(AIS_IsCanSkill(1016)=1&AIS_GetHP()<98&AIS_Rand()<30){AIS_ToSkill(1016);AIS_SetTimes(-1);AIS_SetPRI(40);};斗转星移1016能放就放
7:if(AIS_GetAIState()=SATTACK&AIS_IsCanSkill(1017)=1&AIS_GetHP()<30&AIS_Rand()<40){AIS_ToSkill(1017);AIS_SetTimes(3);AIS_SetPRI(70);};血少于30%后会使用悲酥清风3次
8:if(AIS_GetAIState()=SATTACK&AIS_IsCanSkill(627)=1&AIS_GetHP()<40&AIS_Rand()<20){AIS_ToSkill(627);AIS_SetTimes(-1);AIS_SetPRI(60);};血少于40%使用627冰天雪地
9:if(AIS_IsCanSkill(1023)=1&AIS_GetHP()<90&AIS_Rand()<50){AIS_ToSkill(1023);AIS_SetTimes(-1);AIS_SetPRI(50);};参合指1023能放就放
10:if(AIS_GetAIState()=SATTACK&AIS_Rand()<10&AIS_IsCanSkill(1003)=1){AIS_ToSkill(1003);AIS_SetTimes(40);AIS_SetPRI(35);};在攻击状态10%的机率释放1003号技能，次数40
[skillend]

