--**********************************
--事件列表
--**********************************
function x002054_UpdateEventList( sceneId, selfId,targetId )
local	id	= LuaFnGetMenPai( sceneId, selfId )
local playerMenpai = GetMenPai(sceneId, selfId)
if playerMenpai==0  then
mpname="少林"
elseif   playerMenpai==1  then
mpname="明教"
elseif   playerMenpai==2  then
mpname="丐帮"
elseif   playerMenpai==3  then
mpname="武当"
elseif   playerMenpai==4  then
mpname="峨嵋"
elseif   playerMenpai==5  then
mpname="星宿"
elseif   playerMenpai==6  then
mpname="天龙"
elseif   playerMenpai==7  then
mpname="天山"
elseif   playerMenpai==8  then
mpname="逍遥"
elseif   playerMenpai==9  or   playerMenpai<0 then
mpname="无门派"
elseif   playerMenpai==10  then
mpname="慕容"
elseif   playerMenpai==11  then
mpname="唐门"
end
 BeginEvent(sceneId)
  AddText(sceneId,"#{OBJ_dali_0031}")
  AddText(sceneId,"#P    在我这里可以使用#Y联名推荐信#P兑换重楼装备。")
  AddText(sceneId,"#cFF0000提示：#r#W    3件#Y联名推荐信#W可换一件重楼装备")
  AddText(sceneId, "#c00ffff    你的门派是#Y"..mpname.."#c00ffff，门派id是"..id)
  for i, eventId in x002054_g_eventList do
   CallScriptFunction( eventId, "OnEnumerate",sceneId, selfId, targetId )
  end
  AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G重楼★装备#Y★", 3, 110 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G魂冰珠#Y★#G润魂石#Y★", 3, 120 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G打孔洗髓天灵丹金钢锉#Y★", 3, 130 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G门派转换与更名★", 3, 140 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G高级合成符#Y★", 3, 150 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G功力丹#Y修炼功力丹★", 3, 160 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G先天归心丹#Y★", 3, 170 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G宝石雕刻#Y摘除符★", 3, 180 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G强化露#Y龙玉、精玉★", 3, 190 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G龙珠#Y换龙宝宝★", 3, 200 )
  --AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G玄冥玉#Y寒寒冰星屑★", 3, 210 )
 -- AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G新莽神符#Y新莽神符★", 3, 220 )
 -- AddNumText( sceneId, x002054_g_ScriptId, "#cFF0000兑换#Y★#G龙魂玉#Y玉龙髓#G孩子物品#Y★", 3, 230 )
  --AddNumText( sceneId, x002054_g_ScriptId, "离开……", 14, 0 )
 EndEvent(sceneId)
 DispatchEventList(sceneId,selfId,targetId)
end
 
--**********************************
--事件交互入口
--**********************************
function x002054_OnDefaultEvent( sceneId, selfId,targetId )
 x002054_UpdateEventList( sceneId, selfId, targetId )
end
 
--**********************************
--事件列表选中一项
--**********************************
function x002054_OnEventRequest( sceneId, selfId, targetId, eventId )
 local nNumText = GetNumText()
 if nNumText == 0  then
  -- 关闭窗口
  BeginUICommand(sceneId)
  EndUICommand(sceneId)
  DispatchUICommand(sceneId,selfId, 1000)
  return
 end
    
 
 if nNumText > 100 and nNumText < 800  then
  BeginEvent(sceneId)
   AddText(sceneId, "  不是白给的，用这个东西来换的哦！！")
   
   local nLevel = 0
   if nNumText == 110 then    -- 兑换重楼装备
    nLevel = 1
   end
   if nNumText == 120 then    -- 兑换飞蝗石
    nLevel = 2
   end
   if nNumText == 130 then    -- 兑换梅花镖
    nLevel = 3
   end 
   if nNumText == 140 then    -- 兑换梅花镖
    nLevel = 4
   end      
   if nNumText == 150 then    -- 兑换冰魄神针
    nLevel = 5
   end 
   if nNumText == 160 then    -- 兑换冰魄神针
    nLevel = 6
   end
   if nNumText == 170 then    -- 兑换冰魄神针
    nLevel = 7
   end 
   if nNumText == 180 then    -- 兑换冰魄神针
    nLevel = 8
   end 
   if nNumText == 190 then    -- 兑换贵重石头1
    nLevel = 9
   end 
   if nNumText == 200 then    -- 兑换贵重石头2
    nLevel = 10
   end 
   if nNumText == 210 then    -- 兑换会员装备1
    nLevel = 11
   end 
   if nNumText == 220 then    -- 兑换会员装备2
    nLevel = 12
   end 
   if nNumText == 230 then    -- 兑换会员装备2
    nLevel = 13
   end 
   if nNumText == 410 or nNumText == 411 or nNumText == 412 or nNumText == 413 then
    nLevel = 7
   end 
      
   if nNumText > 400 then
    nLevel = 8
   end
   
   local szStr = "  需要“" .. x002054_g_StoneList[nLevel].str
          .. "”“".. tostring(x002054_g_StoneList[nLevel].num) .. "”个  #W"
   AddText(sceneId, szStr)
   
   for i, item in x002054_g_EquipList do
    if item.n == nNumText  then
     AddRadioItemBonus( sceneId, item.id, 4 )
    end
   end
      EndEvent(sceneId)
      --DispatchMissionDemandInfo(sceneId,selfId,targetId, x002054_g_ScriptId, x210200_g_MissionId)
     DispatchMissionContinueInfo(sceneId,selfId,targetId, x002054_g_ScriptId, 0)  
 end
 
 if nNumText == 800 then
  BeginEvent(sceneId)
   local bStoneOk = 0
   if GetItemCount(sceneId, selfId, 10421021) >= 1  then
   bStoneOk = 1
   end
   if  bStoneOk == 1 then
    BeginEvent(sceneId)
     strText = "你已有此道具，不能重复领取。"
     AddText(sceneId,strText);
    EndEvent(sceneId)
    DispatchMissionTips(sceneId,selfId)
    return
   else 
    TryRecieveItem( sceneId, selfId, 10421021, 1 )
    BeginEvent(sceneId)
     strText = "领取盟主腰带。"
     AddText(sceneId,strText);
    EndEvent(sceneId)
    DispatchMissionTips(sceneId,selfId)    
   end 
  EndEvent(sceneId)
  DispatchEventList(sceneId,selfId,targetId)  
 end
   
 for i, findId in x002054_g_eventList do
  if eventId == findId then   
   CallScriptFunction( eventId, "OnDefaultEvent",sceneId, selfId, targetId )
   return
  end
 end
end
 
--**********************************
--接受此NPC的任务
--**********************************
function x002054_OnMissionAccept( sceneId, selfId, targetId, missionScriptId )
 for i, findId in x002054_g_eventList do
  if missionScriptId == findId then
   ret = CallScriptFunction( missionScriptId, "CheckAccept", sceneId, selfId )
   if ret > 0 then
    CallScriptFunction( missionScriptId, "OnAccept", sceneId, selfId )
   end
   return
  end
 end
 for i, findId in g_eventListTest do
  if missionScriptId == findId then
   ret = CallScriptFunction( missionScriptId, "CheckAccept", sceneId, selfId )
   if ret > 0 then
    CallScriptFunction( missionScriptId, "OnAccept", sceneId, selfId )
   end
   return
  end
 end
end
 
--**********************************
--拒绝此NPC的任务
--**********************************
function x002054_OnMissionRefuse( sceneId, selfId, targetId, missionScriptId )
 --拒绝之后，要返回NPC的事件列表
 for i, findId in x002054_g_eventList do
  if missionScriptId == findId then
   x002054_UpdateEventList( sceneId, selfId, targetId )
   return
  end
 end
 for i, findId in g_eventListTest do
  if missionScriptId == findId then
   x002054_UpdateEventList( sceneId, selfId, targetId )
   return
  end
 end
end
 
--**********************************
--继续（已经接了任务）
--**********************************
function x002054_OnMissionContinue( sceneId, selfId, targetId, missionScriptId )
 for i, findId in x002054_g_eventList do
  if missionScriptId == findId then
   CallScriptFunction( missionScriptId, "OnContinue", sceneId, selfId, targetId )
   return
  end
 end
 for i, findId in g_eventListTest do
  if missionScriptId == findId then
   CallScriptFunction( missionScriptId, "OnContinue", sceneId, selfId, targetId )
   return
  end
 end
end
 
--**********************************
--提交已做完的任务
--**********************************
function x002054_OnMissionSubmit( sceneId, selfId, targetId, missionScriptId, selectRadioId )
 
 --处理提交后的显示情况
 --为了安全，这里要仔细，不能出错
 local nItemIndex = -1
 
 for i, item in x002054_g_EquipList do
  if item.id == selectRadioId  then
   nItemIndex = i
  end
 end
 
 if nItemIndex == -1  then
  return
 end
 
 -- 看完家是不是够材料提交
 local nLevel = 0
 if x002054_g_EquipList[nItemIndex].n > 100 then
  nLevel = 1
 end
 if x002054_g_EquipList[nItemIndex].n > 110 then
  nLevel = 2
 end
 if x002054_g_EquipList[nItemIndex].n > 120 then
  nLevel = 3
 end 
 if x002054_g_EquipList[nItemIndex].n > 130 then 
  nLevel = 4
 end
 if x002054_g_EquipList[nItemIndex].n > 140 then
  nLevel = 5
 end
 if x002054_g_EquipList[nItemIndex].n > 150 then
  nLevel = 6
 end
 if x002054_g_EquipList[nItemIndex].n > 160 then
  nLevel = 7
 end
 if x002054_g_EquipList[nItemIndex].n > 170 then
  nLevel = 8
 end
 if x002054_g_EquipList[nItemIndex].n > 180 then
  nLevel = 9
 end
 if x002054_g_EquipList[nItemIndex].n > 190 then
  nLevel = 10
 end
 if x002054_g_EquipList[nItemIndex].n > 200 then
  nLevel = 11
 end
 if x002054_g_EquipList[nItemIndex].n > 220 then
  nLevel = 13
 end   
 local bStoneOk = 0
 if GetItemCount(sceneId, selfId, x002054_g_StoneList[nLevel].id) >= x002054_g_StoneList[nLevel].num  then
  bStoneOk = 1
 end
 
 if  bStoneOk == 0 then
  BeginEvent(sceneId)
   strText = "你没有足够的物品，不能换取装备。"
   AddText(sceneId,strText);
  EndEvent(sceneId)
  DispatchMissionTips(sceneId,selfId)
  return
 end
 
 -- 检查是不是有足够的石头可以扣除
 if LuaFnGetAvailableItemCount(sceneId, selfId, x002054_g_StoneList[nLevel].id) < x002054_g_StoneList[nLevel].num   then
  BeginEvent(sceneId)
   strText = "你没有足够的物品可以被扣除，请检查物品是否上锁。"
   AddText(sceneId,strText);
  EndEvent(sceneId)
  DispatchMissionTips(sceneId,selfId)
  return
  
 end
 
 -- 检查背包空间
 BeginAddItem(sceneId)
  AddItem(sceneId, selectRadioId, 1)
 local bBagOk = EndAddItem(sceneId, selfId)
 
 if bBagOk < 1 then
  BeginEvent(sceneId)
   strText = "你的背包没有空间了。"
   AddText(sceneId,strText);
  EndEvent(sceneId)
  DispatchMissionTips(sceneId,selfId)
  return
 end
 local nItemBagIndexStone = GetBagPosByItemSn(sceneId, selfId, x002054_g_StoneList[nLevel].id)
 local szTransferStone = GetBagItemTransfer(sceneId,selfId, nItemBagIndexStone)
 
 -- 删除相关的石头
 local bDelOk = LuaFnDelAvailableItem(sceneId,selfId, x002054_g_StoneList[nLevel].id, x002054_g_StoneList[nLevel].num)
 
 if bDelOk < 1  then
  BeginEvent(sceneId)
   strText = "扣出物品失败。"
   AddText(sceneId,strText);
  EndEvent(sceneId)
  DispatchMissionTips(sceneId,selfId)
  return
 else
  --给完家东西，完成
  -- AddItemListToHuman(sceneId,selfId)
  local nBagIndex = TryRecieveItem( sceneId, selfId, x002054_g_EquipList[nItemIndex].id, 1 );
  
  BeginEvent(sceneId)
   strText = "兑换成功。"
   AddText(sceneId,strText);
  EndEvent(sceneId)
  DispatchMissionTips(sceneId,selfId)
  
  local message; 
  local randMessage = random(3);
  local sItemName = GetItemName(sceneId, x002054_g_EquipList[nItemIndex].id)
  
  local szTransferEquip = GetBagItemTransfer(sceneId,selfId, nBagIndex)
  
  if randMessage == 1 then
      message = format("#W#{_INFOUSR%s}#W#{WLS_08}#Y%d#W#{WLS_09}#{_INFOMSG%s}#{WLS_100}#{_INFOMSG%s}#{WLS_11}", LuaFnGetName(sceneId, selfId), x002054_g_StoneList[nLevel].num, szTransferStone, szTransferEquip);
  elseif randMessage == 2 then
   message = format("#W#{_INFOUSR%s}#W#{WLS_03}#Y%d#W#{WLS_04}#{_INFOMSG%s}#{WLS_050}#{_INFOMSG%s}#{WLS_06}#{_INFOMSG%s}#{WLS_07}", LuaFnGetName(sceneId, selfId), x002054_g_StoneList[nLevel].num, szTransferStone, szTransferStone, szTransferEquip);
  else
   message = format("#W#{WLS_000}#Y%d#cffffcc颗#W#{_INFOMSG%s}#cffffcc由衷的赞道：“#W#{_INFOUSR%s}#{WLS_01}#{_INFOMSG%s}#{WLS_02}", x002054_g_StoneList[nLevel].num, szTransferStone, LuaFnGetName(sceneId, selfId), szTransferEquip);
  end
  message = format("#W%s将#{WLS_000}#Y%d#cffffcc封#W#{_INFOMSG%s}交给了天仙妹妹，#cffffcc天仙妹妹由衷的赞道：“#W#{_INFOUSR%s}#{WLS_01}#{_INFOMSG%s}#{WLS_02}", x002054_g_StoneList[nLevel].num, szTransferStone, LuaFnGetName(sceneId, selfId), szTransferEquip);
  BroadMsgByChatPipe(sceneId, selfId, message, 4);
  
  return
 end
 
 for i, findId in x002054_g_eventList do
  if missionScriptId == findId then
   CallScriptFunction( missionScriptId, "OnSubmit", sceneId, selfId, targetId, selectRadioId )
   return
  end
 end
 for i, findId in g_eventListTest do
  if missionScriptId == findId then
   CallScriptFunction( missionScriptId, "OnSubmit", sceneId, selfId, targetId, selectRadioId )
   return
  end
 end
end
 
