[Unit]
Description=NetCo4 admin panel (HTTPS :8443, bat buoc dang nhap)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/tlbb-repo/panel/panel.py
Restart=on-failure
RestartSec=5
# Chi tat chinh panel khi restart/stop, khong tat tien trinh con (phong khi lo spawn game tu panel)
KillMode=process

[Install]
WantedBy=multi-user.target
