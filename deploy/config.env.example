# Chep file nay thanh config.env roi sua PUBLIC_IP.
# Mat khau MySQL se duoc tu sinh ngau nhien vao secrets.env o buoc 01.

# IP public cua VPS (IP ma ban be se ket noi toi)
PUBLIC_IP=""

# Duong dan file o dia may ao da upload len VPS
VMDK="/root/Ubuntu.vmdk"

# Noi giai nen toan bo he dieu hanh Ubuntu 10.04 cua may ao
ROOT="/opt/tlbb-root"

# Noi luu ban sao luu (database goc, database hang ngay)
BACKUP_DIR="/opt/tlbb-backup"

# Bo dem GUID nhan vat moi se bat dau tu so nay (cao hon moi GUID cua server cu,
# de khong trung voi GUID con sot lai trong script)
GUID_START=1010100000

# Ten server hien trong game (chu khong dau)
SERVER_NAME="NetCo4"
